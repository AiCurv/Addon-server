<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF121220"
    android:padding="32dp">

    <!-- Title -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Addon Server"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="#FFFFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Stremio Addon Host + Telegram Control"
        android:textSize="16sp"
        android:textColor="#FF9090A0"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleText" />

    <!-- Server Status Card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/serverCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/card_background"
        android:padding="20dp"
        android:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/subtitleText">

        <View
            android:id="@+id/serverDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/dot_green"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/serverStatusLabel" />

        <TextView
            android:id="@+id/serverStatusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Server: Running"
            android:textSize="22sp"
            android:textColor="#FFE0E0E0"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/serverDot"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/localIpText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IP: 192.168.1.100"
            android:textSize="16sp"
            android:textColor="#FF9090A0"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/serverStatusLabel" />

        <TextView
            android:id="@+id/stremioUrlText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="http://192.168.1.100:7000/manifest.json"
            android:textSize="14sp"
            android:textColor="#FF1A73E8"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/localIpText" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bot Status Card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/botCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/card_background"
        android:padding="20dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/serverCard">

        <View
            android:id="@+id/botDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/dot_green"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/botStatusLabel" />

        <TextView
            android:id="@+id/botStatusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Telegram Bot: Connected"
            android:textSize="22sp"
            android:textColor="#FFE0E0E0"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/botDot"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/botUserText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bot_status_label"
            android:textSize="16sp"
            android:textColor="#FF9090A0"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/botStatusLabel" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Config Card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/configCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/card_background"
        android:padding="20dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/botCard">

        <TextView
            android:id="@+id/configTitleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active Providers"
            android:textSize="22sp"
            android:textColor="#FFE0E0E0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/providersText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="provider_A, provider_B"
            android:textSize="16sp"
            android:textColor="#FF9090A0"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/configTitleLabel" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
