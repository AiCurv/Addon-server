<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- TV Leanback theme - dark background for TV viewing -->
    <style name="Theme.AddonServer.Leanback" parent="Theme.Leanback">
        <item name="colorPrimary">#FF1A73E8</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorSurface">#FF1E1E2E</item>
        <item name="colorOnSurface">#FFE0E0E0</item>
        <item name="android:windowBackground">#FF121220</item>
        <item name="android:textColor">#FFE0E0E0</item>
        <item name="android:textColorSecondary">#FF9090A0</item>
    </style>

    <!-- Status card style -->
    <style name="StatusCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">#FF1E1E2E</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- Status indicator dot -->
    <style name="StatusDot">
        <item name="android:width">12dp</item>
        <item name="android:height">12dp</item>
    </style>
</resources>
